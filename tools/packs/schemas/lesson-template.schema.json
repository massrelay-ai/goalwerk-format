{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "title", "items_kind", "template", "levels"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
    "title": { "type": "string", "minLength": 1 },
    "_comment": { "type": "string" },
    "items_kind": { "const": "steps" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "step_prompt", "evidence_hint", "steps_per_lesson", "review_max"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "step_prompt": { "type": "string", "minLength": 1 },
        "evidence_hint": { "type": "string", "minLength": 1 },
        "steps_per_lesson": { "type": "integer", "minimum": 1 },
        "review_max": { "type": "integer", "minimum": 0 }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "steps"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "steps": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["prompt", "evidence_hint"],
              "properties": { "prompt": { "type": "string", "minLength": 1 }, "evidence_hint": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  }
}
