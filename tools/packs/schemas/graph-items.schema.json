{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "competency",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "competency": {
      "type": "string",
      "pattern": "^comp:[a-z0-9-]+$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "text",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^item:[a-z0-9-]+/[a-z0-9-]+$"
          },
          "kind": {
            "enum": [
              "definition",
              "procedure",
              "fact",
              "figure",
              "example",
              "warning"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "title",
                "licence",
                "retrieved_at",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "licence": {
                  "type": "string",
                  "minLength": 1
                },
                "retrieved_at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "jurisdiction": {
            "enum": [
              "ID",
              "US",
              "global"
            ]
          },
          "valid_until": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "badge": {
            "const": "information_not_advice"
          }
        }
      }
    }
  }
}
