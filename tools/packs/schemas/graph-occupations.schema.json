{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "occupations"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "occupations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "job_family",
          "job_zone",
          "part_of",
          "top"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^occ:[0-9]{2}-[0-9]{4}\\.[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "job_family": {
            "type": "string",
            "pattern": "^([0-9]{2}|none)$"
          },
          "job_zone": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "part_of": {
            "type": "string",
            "pattern": "^sector:[a-z0-9-]+$"
          },
          "top": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": [
                "comp",
                "element",
                "importance"
              ],
              "additionalProperties": false,
              "properties": {
                "comp": {
                  "type": "string",
                  "pattern": "^comp:[a-z0-9-]+$"
                },
                "element": {
                  "type": "string",
                  "pattern": "^[0-9A-Za-z.]+$"
                },
                "importance": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5
                }
              }
            }
          }
        }
      }
    }
  }
}
