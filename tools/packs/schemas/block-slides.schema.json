{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slides",
    "sources"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "bullets",
          "item_refs"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "bullets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          },
          "item_refs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "picture": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "caption",
              "source",
              "licence",
              "retrievedAt"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://",
                "maxLength": 2000
              },
              "caption": {
                "type": "string",
                "maxLength": 200
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "licence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "retrievedAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "title",
          "licence",
          "retrievedAt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "licence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          }
        }
      }
    }
  }
}
