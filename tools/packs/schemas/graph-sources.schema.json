{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "url",
    "title",
    "licence",
    "retrieved_at",
    "sha256",
    "bytes"
  ],
  "additionalProperties": false,
  "properties": {
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "normalize": {
      "enum": [
        "akamai-ids",
        "aspnet-viewstate",
        "none"
      ]
    }
  }
}
