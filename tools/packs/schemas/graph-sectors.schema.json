{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "onet_release",
    "sectors"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "onet_release": {
      "type": "string",
      "minLength": 1
    },
    "sectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "regulated",
          "job_families",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sector:[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "regulated": {
            "type": "boolean"
          },
          "job_families": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
