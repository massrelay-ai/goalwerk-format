{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "lessons"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "node",
          "title",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^lesson:[a-z0-9-]+/[a-z0-9-]+/[0-9]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "node": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "prompt",
                "evidence_hint",
                "item"
              ],
              "additionalProperties": false,
              "properties": {
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_hint": {
                  "type": "string",
                  "minLength": 1
                },
                "item": {
                  "type": "string",
                  "pattern": "^item:[a-z0-9-]+/[a-z0-9-]+$"
                }
              }
            }
          }
        }
      }
    }
  }
}
