{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The LOCALE layer (spec 01 section 5): <path_id>.<locale>.json. Strings carry no minLength on purpose: an empty string is the finding i18n_empty_string, the same code in both validators.",
  "type": "object",
  "required": ["path_id", "locale", "nodes"],
  "additionalProperties": false,
  "properties": {
    "path_id": { "type": "string" },
    "locale": { "type": "string" },
    "_comment": { "type": "string" },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "lesson"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "lesson": {
            "type": "object",
            "required": ["steps"],
            "additionalProperties": false,
            "properties": {
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["prompt", "evidence_hint"],
                  "additionalProperties": false,
                  "properties": { "prompt": { "type": "string" }, "evidence_hint": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
